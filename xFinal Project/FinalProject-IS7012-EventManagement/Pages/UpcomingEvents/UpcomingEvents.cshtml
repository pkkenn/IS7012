@page
@model EventManagement.Pages.UpcomingEvents.UpcomingEventsModel
@{
    ViewData["Title"] = "Upcoming Events";
}

<h1 class="text-primary mb-4">Upcoming Events</h1>

@if (Model.Events.Count == 0)
{
    <div class="alert alert-warning">There are no upcoming events.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Event Title</th>
                <th>Date</th>
                <th>Location</th>
                <th>Organizer</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.Date.ToString("MMMM dd, yyyy")</td>
                <td>@e.Location</td>
                <td>@e.Organizer.Name</td>
            </tr>
        }
        </tbody>
    </table>
}
