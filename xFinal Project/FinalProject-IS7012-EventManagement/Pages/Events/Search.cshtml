@page
@model EventManagement.Pages.Events.SearchModel
@{
    ViewData["Title"] = "Search Events";
}

<h1>Search Events</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text"
               name="Query"
               value="@Model.Query"
               class="form-control"
               placeholder="Search by title or location" />
    </div>

    <div class="col-md-3">
        <input type="date"
               name="Date"
               value="@(Model.Date?.ToString("yyyy-MM-dd"))"
               class="form-control" />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>

@if (Model.Events.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Location</th>
                <th>Organizer</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.Date.ToShortDateString()</td>
                <td>@e.Location</td>
                <td>@e.Organizer?.Name</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No events found matching your search.</p>
}
