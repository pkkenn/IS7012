@page
@model EventManagement.Pages.Events.IndexModel

@{
    ViewData["Title"] = "All Events";
}

<h1 class="mb-3 text-primary">All Events</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Event</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Event Title</th>
            <th>Date</th>
            <th>Location</th>
            <th>Organizer</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Events)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Date.ToShortDateString()</td>
                <td>@item.Location</td>
                <td>@item.Organizer?.Name</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


